{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=netdropbox;Username=netdropbox;Password=netdropbox"
  },
  "Jwt": {
    "Issuer": "NetDropbox",
    "Audience": "NetDropboxClient",
    "SigningKey": "local-development-signing-key-change-me-32chars"
  },
  "Storage": {
    "Provider": "Local",
    "LocalRoot": "storage",
    "S3": {
      "ServiceUrl": "http://localhost:9000",
      "AccessKey": "netdropbox",
      "SecretKey": "netdropbox-secret",
      "Bucket": "netdropbox"
    }
  },
  "Chunks": {
    "Root": "chunks"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
